{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FarfaLauncher",
  "version": "0.1.0",
  "identifier": "fr.farfaboulette.farfalauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FarfaLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' asset: http://asset.localhost blob:; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "publisher": "Farfaboulette7",
    "shortDescription": "Launcher de portages PC hébergés sur RomM",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "CLE_PUBLIQUE_A_RENSEIGNER",
      "endpoints": ["https://github.com/Farfaboulette7/FarfaLauncher/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
